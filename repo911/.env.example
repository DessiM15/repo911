# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_LEAD_PRICE_HOT=100000    # cents ($1,000)
STRIPE_LEAD_PRICE_WARM=60000    # cents ($600)
STRIPE_LEAD_PRICE_COLD=30000    # cents ($300)
STRIPE_SUBSCRIPTION_PRICE_ID=   # Stripe Price ID for $2,000/mo unlimited plan

# Resend (email)
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=notify@yourdomain.com

# Optional: Admin notification recipient (defaults to EMAIL_FROM)
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=Repo911
